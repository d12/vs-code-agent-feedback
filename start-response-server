#!/usr/bin/env bash
# Start the response server for agent approval requests
# This server provides a web interface for approving agent work

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_SCRIPT="$SCRIPT_DIR/../response-server/server.rb"

# Show help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: ./start-response-server [OPTIONS]"
    echo ""
    echo "Start the web-based response server for agent approval requests."
    echo "This server should run on your LOCAL machine and will automatically"
    echo "discover MCP clients running in CodeSpaces via port forwarding."
    echo ""
    echo "Options:"
    echo "  -p, --port PORT         Port for web interface (default: 18463)"
    echo "  -n, --notifications MODE  Notification mode (default: server)"
    echo "                            server - OS notifications, clicks focus Chrome"
    echo "                            web    - Browser notifications only"
    echo "                            both   - Both server and browser notifications"
    echo "  -h, --help              Show this help"
    echo ""
    echo "Environment Variables:"
    echo "  RESPONSE_SERVER_PORT    Default port"
    echo "  NOTIFICATION_MODE       Default notification mode"
    echo ""
    echo "The server will:"
    echo "  1. Serve a web UI at http://localhost:PORT"
    echo "  2. Poll ports 14700-14715 to discover MCP clients"
    echo "  3. Show agent requests from all connected CodeSpaces"
    echo ""
    echo "Examples:"
    echo "  ./start-response-server                    # Server notifications (default)"
    echo "  ./start-response-server -n web             # Browser notifications only"
    echo "  ./start-response-server -n server          # OS notifications, focus Chrome"
    echo "  ./start-response-server -p 8080 -n both    # Port 8080, both notification types"
    exit 0
fi

# Check if Ruby is available
if ! command -v ruby &> /dev/null; then
    echo "❌ Error: Ruby is not installed or not in PATH"
    echo "   Please install Ruby 3.x to use this server"
    exit 1
fi

# Check if server script exists
if [[ ! -f "$SERVER_SCRIPT" ]]; then
    echo "❌ Error: Server script not found at $SERVER_SCRIPT"
    exit 1
fi

echo "🚀 Starting response server..."
echo "   Press Ctrl+C to stop"
echo ""

# Pass all arguments to Ruby script
exec ruby "$SERVER_SCRIPT" "$@"
